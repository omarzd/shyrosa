{
  "cleanupPeriodDays": 36500,
  "env": {
    "CLAUDE_CODE_DISABLE_AUTO_MEMORY": "1"
  },
  "permissions": {
    "deny": [
      "NotebookEdit",
      "EnterPlanMode",
      "ExitPlanMode",
      "RemoteTrigger",
      "CronCreate",
      "CronDelete",
      "CronList",
      "DesignSync",
      "PushNotification",
      "ReportFindings",
      "AskUserQuestion"
    ]
  },
  "disableClaudeAiConnectors": true,
  "disableBundledSkills": true,
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.shyrosa/scripts/preferences.py --brief"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.shyrosa/scripts/check-writing-for-agents.py"
          },
          {
            "type": "command",
            "command": "python3 ~/.shyrosa/scripts/check-handoff-write.py"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.shyrosa/scripts/check-preferences.py"
          }
        ]
      }
    ]
  },
  "disableRemoteControl": true,
  "disableArtifact": true,
  "enableWorkflows": true,
  "statusLine": {
    "type": "command",
    "command": "python3 ~/.claude/statusline-context.py",
    "padding": 0
  },
  "enabledPlugins": {
    "cc-plugin-you-should-know@builtin": false
  },
  "outputStyle": "Unslop",
  "feedbackDrafts": "off",
  "effortLevel": "xhigh",
  "modelSettings": {
    "claude-opus-5": {
      "effortLevel": "xhigh"
    },
    "claude-opus-5-5": {
      "effortLevel": "medium"
    }
  },
  "tui": "fullscreen",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "autoMemoryEnabled": false,
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "dark",
  "autoCompactEnabled": false,
  "idleCompaction": false,
  "agentPushNotifEnabled": true,
  "voiceEnabled": true
}
